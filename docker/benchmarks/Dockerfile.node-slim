# syntax=docker/dockerfile:1
ARG NODE_IMAGE=node:22.23.4-bookworm-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da
FROM ${NODE_IMAGE} AS build
RUN apt-get update && apt-get -y dist-upgrade \
    && apt-get install -y --no-install-recommends \
      python3 build-essential libzmq3-dev libprotobuf-dev git graphicsmagick yasm cmake ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /build
RUN chown node:node /build
USER node
COPY --chown=node:node package.json package-lock.json ./
RUN npm install --omit=optional --no-audit --no-fund
COPY --chown=node:node . .
RUN npm pack --quiet > /tmp/package-name \
    && mkdir /tmp/app && tar -xzf "$(tail -n 1 /tmp/package-name)" --strip-components=1 -C /tmp/app \
    && npm prune --omit=dev --no-audit --no-fund \
    && mv node_modules /tmp/app/ \
    && cd /tmp/app && rm -rf doc .github .tx .semaphore *.md *.yaml LICENSE Dockerfile* \
      .eslintrc .nvmrc .tool-versions res/.eslintrc \
    && mkdir bundletool \
    && node -e 'fetch("https://github.com/google/bundletool/releases/download/1.2.0/bundletool-all-1.2.0.jar").then(async r => {if (!r.ok) throw new Error(String(r.status)); require("fs").writeFileSync("bundletool/bundletool.jar", Buffer.from(await r.arrayBuffer()))}).catch(e => {console.error(e); process.exit(1)})'

FROM ${NODE_IMAGE} AS runtime
ARG TARGETARCH
RUN apt-get update && apt-get -y dist-upgrade \
    && apt-get install -y --no-install-recommends \
      ca-certificates graphicsmagick openjdk-17-jre-headless libzmq5 libprotobuf32 libstdc++6 \
    && rm -rf /var/lib/apt/lists/* \
    && if [ "$TARGETARCH" = amd64 ]; then stf_uid=998; else stf_uid=999; fi \
    && groupadd --system --gid "$stf_uid" stf \
    && useradd --system --uid "$stf_uid" --gid stf --create-home --shell /usr/sbin/nologin stf
ENV PATH=/app/bin:$PATH
WORKDIR /app
COPY --from=build --chown=stf:stf /tmp/app/ /app/
EXPOSE 3000
USER stf
CMD ["stf", "--help"]
